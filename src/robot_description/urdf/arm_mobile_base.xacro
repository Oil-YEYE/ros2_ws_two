<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <link name="arm_base_link">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.02"/>
            </geometry>
            <origin xyz="0 0 0.01" rpy="0 0 0"/>
            <material name="pink" />
        </visual>

        <collision>
            <geometry>
                <box size="0.1 0.1 0.02"/>
            </geometry>
            <origin xyz="0 0 0.01" rpy="0 0 0"/>
        </collision>

        <xacro:box_inertia m="0.5" x="0.1" y="0.1" z="0.02"
        o_xyz="0 0 0.01" o_rpy="0 0 0" />
    </link>

    <link name="forearm_link">

        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.3"/>
            </geometry>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <material name="yellow"/>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.3"/>
            </geometry>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
        </collision>

        <xacro:cylinder_inertia m="0.3" r="0.02" l="0.3"
        o_xyz="0 0 0.15" o_rpy="0 0 0" />
    </link>

    <link name="hand_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.3"/>
            </geometry>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <material name="orange"/>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.3"/>
            </geometry>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
        </collision>


        <xacro:cylinder_inertia m="0.3" r="0.02" l="0.3"
        o_xyz="0 0 0.15" o_rpy="0 0 0" />
    </link>
    


    <joint name="base_to_forearm" type="revolute">
        <parent link="arm_base_link" />
        <child link="forearm_link" />
        <origin xyz="0 0 0.02" rpy="0 0 0"/>

        <axis xyz="1 0 0"/>

        <limit lower="0" upper="${pi/2}" effort="100" velocity="100"/>
        <dynamics
            damping="0.3"
            friction="0.3"/>
    </joint>

    <joint name="forearm_to_hand" type="revolute">
        <parent link="forearm_link" />
        <child link="hand_link" />
        <origin xyz="0 0 0.3" rpy="0 0 0"/>

        <axis xyz="1 0 0"/>

        <limit lower="0" upper="${pi/2}" effort="100" velocity="100"/>

        <dynamics
            damping="0.3"
            friction="0.3"/>
    </joint>


    <gazebo>
        <plugin
            filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">

            <parameters>
                /home/yeye/ros2_ws_two/src/arm/config/controllers.yaml
            </parameters>

        </plugin>
    </gazebo>

    <ros2_control name="arm_system" type="system">

        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>


        <joint name="base_to_forearm">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>


        <joint name="forearm_to_hand">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>

    </ros2_control>

</robot>